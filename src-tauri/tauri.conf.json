{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASAB AeroLab",
  "version": "0.1.0",
  "identifier": "com.asab.aerolab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "عَصَب | أيرولاب",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false
  }
}
